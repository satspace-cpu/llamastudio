## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Publish results
publish/

# NuGet Packages
*.nupkg
*.snupkg

# Visual Studio cache/options directory
.vs/

# JetBrains Rider
.idea/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Logs and backups
*.log
*_backup_*.zip
backup_*/

# Internal dev files
AGENTS.md
CONTEXT.md
TELEGRAM_SETUP.md

# Source code - kept local only
src/
