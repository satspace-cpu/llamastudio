<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermass.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Hermass.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="20">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="White"/>

            <!-- Status Cards -->
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                <!-- Server Status -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="#1E1B4B" CornerRadius="12" Padding="20"
                        Margin="0,0,8,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ServerLabel}" FontSize="13"
                                    Foreground="#818CF8"/>
                        <TextBlock Text="{Binding ServerStatus.State}"
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding ServerStatus.Uptime, StringFormat='Uptime: {0:hh\:mm\:ss}'}"
                                   FontSize="12" Foreground="#A5B4FC"/>
                    </StackPanel>
                </Border>

                <!-- Models -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="#064E3B" CornerRadius="12" Padding="20"
                        Margin="8,0,8,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ModelsCard}" FontSize="13" Foreground="#34D399"/>
                        <TextBlock Text="{Binding TotalModels}"
                                    FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Indexed}" FontSize="12" Foreground="#6EE7B7"/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="#7C2D12" CornerRadius="12" Padding="20"
                        Margin="8,0,8,8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ProfilesCard}" FontSize="13" Foreground="#FDBA74"/>
                        <TextBlock Text="{Binding TotalProfiles}"
                                    FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Saved}" FontSize="12" Foreground="#FED7AA"/>
                    </StackPanel>
                </Border>

                <!-- Version -->
                <Border Grid.Row="0" Grid.Column="3"
                        Background="#1E3A5F" CornerRadius="12" Padding="20"
                        Margin="8,0,0,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding LlamaCppCard}" FontSize="13" Foreground="#60A5FA"/>
                        <TextBlock Text="{Binding ActiveVersion}"
                                   FontSize="14" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionStatusText}" FontSize="11" Foreground="#93C5FD"/>
                        <Button Content="{Binding UpdateBtnText}"
                                Command="{Binding UpdateLlamaCppCommand}"
                                IsVisible="{Binding HasUpdate}"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" CornerRadius="6" Padding="10,6"
                                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- VRAM Usage -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="#1F1533" CornerRadius="12" Padding="20"
                        Margin="0,8,8,0">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VramUsage}" FontSize="14"
                                        FontWeight="SemiBold" Foreground="#A78BFA"/>
                            <TextBlock Text="{Binding EstimatedVramGb, StringFormat=' {0:F1} GB'}"
                                        FontSize="14" Foreground="#C4B5FD"
                                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding VramPercentage}" Maximum="100"
                                      Height="8" CornerRadius="4"
                                      Background="#2D1B69"
                                      Foreground="#7C3AED"/>
                        <TextBlock Text="{Binding GpuMemory}" FontSize="11" Foreground="#6D5E9E"/>
                    </StackPanel>
                </Border>

                <!-- Selected Model -->
                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                        Background="#172554" CornerRadius="12" Padding="20"
                        Margin="8,8,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding ActiveModelLabel}" FontSize="14"
                                    FontWeight="SemiBold" Foreground="#60A5FA"/>
                        <TextBlock Text="{Binding SelectedModel}"
                                   FontSize="13" Foreground="#BFDBFE"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <TextBlock Text="{Binding QuickActions}" FontSize="18" FontWeight="SemiBold" Foreground="#E5E7EB"/>

            <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Models"
                        CornerRadius="12"
                        Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1"
                        Margin="0,0,8,0" Padding="20">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                  Width="28" Height="28" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding ScanModelsBtn}" FontSize="14" FontWeight="SemiBold"
                                    Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DiscoverGguf}" FontSize="12"
                                    Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Profiles"
                        CornerRadius="12"
                        Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1"
                        Margin="8,0,8,0" Padding="20">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                  Width="28" Height="28" Foreground="#8B5CF6"/>
                        <TextBlock Text="{Binding CreateProfileBtn}" FontSize="14" FontWeight="SemiBold"
                                    Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LaunchConfig}" FontSize="12"
                                    Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Settings"
                        CornerRadius="12"
                        Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1"
                        Margin="8,0,0,0" Padding="20">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                  Width="28" Height="28" Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding GetUpdateButtonLabel}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LlamaVersionLabel}" FontSize="12"
                                   Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>