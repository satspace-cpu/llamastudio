function modelsUi(){let page=document.getElementById('models');if(!page||document.getElementById('modelsUi'))return;let style=document.createElement('style');style.id='modelsUiStyle';style.textContent='.hf-panel{background:#1f2937;border:1px solid #374151;border-radius:10px;padding:20px;margin-bottom:18px}.hf-title{font-size:20px;font-weight:700;color:#dbeafe;margin-bottom:14px}.hf-row{display:flex;gap:8px;align-items:center;margin:9px 0}.hf-row input{flex:1}.hf-actions{display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid #374151;margin-top:16px;padding-top:16px}.hf-files{max-height:340px;overflow:auto;margin-top:12px}.hf-file{display:flex;gap:10px;align-items:center;padding:8px 10px;border-bottom:1px solid #26364f}.hf-file small{color:#9ca3af;margin-left:auto}.hf-search-results{position:relative;z-index:2}.hf-result{display:flex;justify-content:space-between;gap:10px;align-items:center;background:#101827;border:1px solid #374151;border-radius:7px;padding:9px;margin:5px 0}.model-card{background:#101827;border:1px solid #374151;border-radius:8px;padding:14px;margin:9px 0}.model-head{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.model-head b{color:#bfdbfe}.badge{border-radius:5px;padding:3px 7px;background:#4338ca;font-size:11px}.badge.quant{background:#2563eb}.model-meta{color:#9ca3af;font-size:12px;margin:8px 0}.model-actions{display:flex;gap:8px;flex-wrap:wrap}.models-status{min-height:22px;color:#34d399;margin-top:8px}.models-error{color:#f87171}.path-row{display:flex;gap:8px;align-items:center}.path-row input{flex:1}';document.head.appendChild(style);page.innerHTML='<h1>Модели</h1><div id="modelsUi"><div class="hf-panel"><div class="hf-title">🤗 HuggingFace Download</div><div class="hf-row"><span>🔑</span><input id="hfToken" type="password" placeholder="Токен авторизации HF (для приватных репозиториев)"><button onclick="hfSaveToken()">Сохранить токен</button></div><div class="hf-row"><span>🔎</span><input id="hfSearch" placeholder="Введите название модели для поиска HuggingFace"><button onclick="hfSearchModels()">Поиск</button></div><div id="hfSearchResults" class="hf-search-results"></div><div class="hf-row"><span>🌐</span><input id="hfRepo" placeholder="Репозиторий, например TheBloke/model-GGUF"><button onclick="hfFetchRepo()">Получить файлы</button></div><div class="path-row"><span>📁</span><input id="hfDir" placeholder="Каталог загрузки и моделей"><button onclick="hfSaveDir()">Сохранить каталог</button></div><div id="hfStatus" class="models-status"></div><div id="hfFiles" class="hf-files"></div><div class="hf-actions"><button onclick="hfSelectAll()">Выбрать все</button><button class="secondary" onclick="hfDeselectAll()">Снять выбор</button><button class="green" onclick="hfDownloadSelected()">Скачать выбранные</button><button class="stop" onclick="hfCancel()">Отмена</button><button class="secondary" onclick="hfPause()">Пауза</button></div></div><section><div class="row"><h2 style="flex:1">Модели <span id="modelsCount" class="muted"></span></h2><button onclick="scanModelsWeb()">Сканировать модели</button></div><div class="path-row"><input id="modelsDir" placeholder="Каталог моделей"><button onclick="setModelsDirWeb()">Выбрать каталог</button></div><input id="modelsFilter" placeholder="Поиск моделей…" oninput="renderLocalModels()"><div id="localModels"></div></section></div>';loadModelSettings();scanModelsWeb()}
async function loadModelSettings(){try{let s=await json('/api/settings');let d=s.modelsDirectory||'';for(const id of ['hfDir','modelsDir']){let e=document.getElementById(id);if(e)e.value=d}addModelFolderButtons()}catch{}}
function addModelFolderButtons(){for(const id of ['hfDir','modelsDir']){let e=document.getElementById(id),row=e?.parentElement;if(!e||!row||row.querySelector('.native-browse'))continue;let b=document.createElement('button');b.className='secondary native-browse';b.textContent='Обзор…';b.onclick=()=>window.browseModelsDirectory(id);row.appendChild(b)}}
async function browseModelsDirectory(targetId){let input=document.getElementById(targetId),st=document.getElementById('hfStatus');try{if(st)st.textContent='Открывается выбор каталога…';let r=await json('/api/models/browse?path='+encodeURIComponent(input?.value||''));if(!r.ok)return;if(document.getElementById('hfDir'))document.getElementById('hfDir').value=r.directory;if(document.getElementById('modelsDir'))document.getElementById('modelsDir').value=r.directory;if(st)st.textContent='Каталог выбран: '+r.directory;await scanModelsWeb()}catch(e){if(st)st.textContent='Не удалось выбрать каталог: '+e.message}}
function modelQuant(name){let m=String(name).match(/(?:Q[0-9]+[_A-Z0-9]*|F16|F32|BF16)/i);return m?m[0].toUpperCase():''}
function renderSpeedMonitor(s){let page=document.getElementById('monitoring');if(!page)return;let box=document.getElementById('speedMonitor');if(!box){box=document.createElement('div');box.id='speedMonitor';page.appendChild(box)}let busy=!!s.isBenchmarking;let gen=Number(s.tokensPerSecond||0);let prompt=Number(s.promptTokensPerSecond||0);box.innerHTML='<section><div class="row"><h2 style="flex:1">Скорость генерации</h2><button class="green" onclick="measureSpeedWeb()"'+(busy?' disabled':'')+'>'+(busy?'Измерение…':'Измерить скорость')+'</button></div><div class="grid"><div class="tile"><span class="label">Токены генерации</span><b>'+gen.toFixed(1)+' токенов/с</b><div class="metricline"><span>Скорость</span><span>'+gen.toFixed(1)+' токенов/с</span></div><div class="bar green"><i style="width:'+Math.min(100,gen/300*100)+'%"></i></div></div><div class="tile"><span class="label">Обработка prompt</span><b>'+prompt.toFixed(1)+' токенов/с</b><div class="metricline"><span>Скорость</span><span>'+prompt.toFixed(1)+' токенов/с</span></div><div class="bar"><i style="width:'+Math.min(100,prompt/3000*100)+'%"></i></div></div></div>'+(s.result?'<div class="notice bad">'+esc(s.result)+'</div>':'')+'</section>'}
// Keep the web cards in the same order as the desktop monitor: prompt first, generation second.
function renderSpeedMonitor(s){let page=document.getElementById('monitoring');if(!page)return;let box=document.getElementById('speedMonitor');if(!box){box=document.createElement('div');box.id='speedMonitor';page.appendChild(box)}let busy=!!s.isBenchmarking;let gen=Number(s.tokensPerSecond||0),prompt=Number(s.promptTokensPerSecond||0);box.innerHTML='<section><div class="row"><h2 style="flex:1">Скорость генерации</h2><button class="green" onclick="measureSpeedWeb()"'+(busy?' disabled':'')+'>'+(busy?'Измерение…':'Измерить скорость')+'</button></div><div class="grid"><div class="tile"><span class="label">Обработка prompt</span><b>'+prompt.toFixed(1)+' токенов/с</b><div class="metricline"><span>Скорость</span><span>'+prompt.toFixed(1)+' токенов/с</span></div><div class="bar"><i style="width:'+Math.min(100,prompt/3000*100)+'%"></i></div></div><div class="tile"><span class="label">Токены генерации</span><b>'+gen.toFixed(1)+' токенов/с</b><div class="metricline"><span>Скорость</span><span>'+gen.toFixed(1)+' токенов/с</span></div><div class="bar green"><i style="width:'+Math.min(100,gen/300*100)+'%"></i></div></div></div>'+(s.result?'<div class="notice bad">'+esc(s.result)+'</div>':'')+'</section>'}
function placeSpeedMonitor(){let page=document.getElementById('monitoring'),box=document.getElementById('speedMonitor'),heading=page?.querySelector('h1');if(page&&box&&heading&&heading.nextSibling!==box)page.insertBefore(box,heading.nextSibling)}
async function speedInfoLoad(){try{let d=await json('/api/monitoring?id='+encodeURIComponent(currentId));renderSpeedMonitor(d.speed||{});placeSpeedMonitor()}catch(e){renderSpeedMonitor({result:'Не удалось получить скорость: '+e.message});placeSpeedMonitor()}}
async function measureSpeedWeb(){let box=document.getElementById('speedMonitor');if(box)box.scrollIntoView({block:'nearest'});renderSpeedMonitor({isBenchmarking:true});try{let r=await fetch('/api/monitoring/speed');let s=await r.json();renderSpeedMonitor(s)}catch(e){renderSpeedMonitor({result:'Ошибка измерения скорости: '+e.message})}}
function renderLocalModels(){let box=document.getElementById('localModels');if(!box)return;let q=(document.getElementById('modelsFilter')?.value||'').toLowerCase();let list=(modelsState.local||[]).filter(x=>String(x.fileName||x.name||'').toLowerCase().includes(q));let c=document.getElementById('modelsCount');if(c)c.textContent=list.length+' моделей';box.innerHTML=list.map(x=>{let name=x.fileName||x.name||'';let path=x.path||x.fullName||'';let isMm=String(name).toLowerCase().includes('mmproj');let quant=x.quantizationTag||modelQuant(name);let sizeGb=Number(x.sizeGb)||Number(x.sizeBytes||0)/1073741824;let meta=[x.architecture||'unknown',quant,x.layerCount?(x.layerCount+' layers'):'',x.estimatedVramGb?('~'+Number(x.estimatedVramGb).toFixed(1)+' GB VRAM'):''].filter(Boolean).join(' · ');let flags=(x.hasMtp?'<span class="badge">MTP</span>':'')+(x.isVision?'<span class="badge quant">Vision</span>':'');return '<div class="model-card"><div class="model-head"><b>'+esc(name)+'</b><span class="badge">GGUF</span>'+(quant?'<span class="badge quant">'+esc(quant)+'</span>':'')+flags+'</div><div class="model-meta">'+esc(sizeGb.toFixed(2))+' GB · '+esc(meta)+'</div><div class="model-meta">'+esc(path)+'</div><div class="model-actions"><button class="green" onclick="useModelWeb(\''+esc(path).replace(/'/g,'\\\'')+'\','+(!isMm)+')">'+(isMm?'Использовать mmproj':'Модель сервера')+'</button></div></div>'}).join('')||'<div class="muted">Модели не найдены</div>'}
function renderLocalModels(){let box=document.getElementById('localModels');if(!box)return;let q=(document.getElementById('modelsFilter')?.value||'').toLowerCase();let list=(modelsState.local||[]).filter(x=>String(x.name).toLowerCase().includes(q));let c=document.getElementById('modelsCount');if(c)c.textContent=list.length+' моделей';box.innerHTML=list.map(x=>{let quant=modelQuant(x.name);let isMm=String(x.name).toLowerCase().includes('mmproj');return '<div class="model-card"><div class="model-head"><b>'+esc(x.name)+'</b><span class="badge">GGUF</span>'+(quant?'<span class="badge quant">'+esc(quant)+'</span>':'')+'</div><div class="model-meta">'+esc(Number(x.sizeGb||0).toFixed(2))+' GB · '+esc(x.path)+'</div><div class="model-actions"><button class="green" onclick="useModelWeb(\''+esc(x.path).replace(/'/g,'\\\'')+'\','+(!isMm)+')">'+(isMm?'Использовать mmproj':'Модель сервера')+'</button></div></div>'}).join('')||'<div class="muted">Модели не найдены</div>'}
async function scanModelsWeb(){try{let dir=document.getElementById('modelsDir')?.value||'';let url=dir?'/api/models/scan?path='+encodeURIComponent(dir):'/api/models';let m=await json(url);modelsState.local=m;renderLocalModels();let st=document.getElementById('hfStatus');if(st)st.textContent='Сканирование завершено: '+m.length+' моделей'}catch(e){let st=document.getElementById('hfStatus');if(st)st.textContent='Ошибка сканирования: '+e.message}}
async function setModelsDirWeb(){let dir=document.getElementById('modelsDir')?.value.trim();if(!dir)return;let r=await fetch('/api/models/directory?path='+encodeURIComponent(dir));let st=document.getElementById('hfStatus');if(st)st.textContent=r.ok?'Каталог моделей сохранён':'Каталог не найден';if(r.ok){document.getElementById('hfDir').value=dir;await scanModelsWeb()}}
async function useModelWeb(path,isModel){let q=new URLSearchParams({id:currentId});q.set(isModel?'modelPath':'mmprojPath',path);let r=await fetch('/api/profile/save?'+q);let st=document.getElementById('hfStatus');if(st)st.textContent=r.ok?(isModel?'Модель сервера назначена':'mmproj назначен'):'Не удалось сохранить профиль';if(r.ok)await profileForm()}
async function hfSaveToken(){let token=document.getElementById('hfToken')?.value||'';let r=await fetch('/api/hf/token/save?token='+encodeURIComponent(token));let st=document.getElementById('hfStatus');if(st)st.textContent=r.ok?'Токен HuggingFace сохранён':'Не удалось сохранить токен'}
async function hfSearchModels(){let q=document.getElementById('hfSearch')?.value.trim();let box=document.getElementById('hfSearchResults');if(!q||!box)return;box.innerHTML='<div class="muted">Поиск…</div>';try{let r=await json('/api/hf/search?q='+encodeURIComponent(q));box.innerHTML=r.map(x=>'<div class="hf-result"><span><b>'+esc(x.id||x.name||'')+'</b><br><small class="muted">'+esc(x.description||'')+'</small></span><button onclick="selectHfRepo(\''+esc(x.id||'').replace(/'/g,'\\\'')+'\')">Выбрать</button></div>').join('')||'<div class="muted">Ничего не найдено</div>'}catch(e){box.innerHTML='<div class="models-error">Ошибка поиска: '+esc(e.message)+'</div>'}}
function selectHfRepo(repo){document.getElementById('hfRepo').value=repo;document.getElementById('hfSearchResults').innerHTML='';hfFetchRepo()}
async function hfFetchRepo(){let repo=document.getElementById('hfRepo')?.value.trim();let dir=document.getElementById('hfDir')?.value.trim();if(!repo)return;modelsState.repo=repo;modelsState.dir=dir||'';let st=document.getElementById('hfStatus');if(st)st.textContent='Получение списка файлов…';try{modelsState.files=await json('/api/hf/repo?repo='+encodeURIComponent(repo)+'&dir='+encodeURIComponent(modelsState.dir));modelsState.selected=new Set(modelsState.files.filter(x=>!x.isCompleted&&/\.gguf$/i.test(x.fileName||'')).map(x=>x.fileName));renderHfFiles();if(st)st.textContent='Найдено файлов: '+modelsState.files.length}catch(e){if(st)st.textContent='Ошибка HuggingFace: '+e.message}}
function renderHfFiles(){let box=document.getElementById('hfFiles');if(!box)return;box.innerHTML=modelsState.files.map(x=>'<label class="hf-file"><input type="checkbox" '+(modelsState.selected.has(x.fileName)?'checked':'')+' onchange="toggleHfFile(\''+esc(x.fileName).replace(/'/g,'\\\'')+'\',this.checked)"><span>'+esc(x.fileName)+'</span><small>'+esc(x.isCompleted?'Уже скачан':(x.size?((Number(x.size)/1073741824).toFixed(2)+' GB'):'—'))+'</small></label>').join('')||'<div class="muted">Файлы не найдены</div>'}
function toggleHfFile(name,on){if(on)modelsState.selected.add(name);else modelsState.selected.delete(name)}function hfSelectAll(){modelsState.files.forEach(x=>{if(/\.gguf$/i.test(x.fileName||'')&&!x.isCompleted)modelsState.selected.add(x.fileName)});renderHfFiles()}function hfDeselectAll(){modelsState.selected.clear();renderHfFiles()}
async function hfDownloadSelected(){let st=document.getElementById('hfStatus');if(!modelsState.repo||!modelsState.dir||!modelsState.selected.size){if(st)st.textContent='Укажите репозиторий, каталог и выберите файлы';return}if(st)st.textContent='Загрузка…';let r=await fetch('/api/hf/download?repo='+encodeURIComponent(modelsState.repo)+'&dir='+encodeURIComponent(modelsState.dir)+'&files='+encodeURIComponent([...modelsState.selected].join(',')));if(st)st.textContent=r.ok?'Загрузка завершена':'Ошибка загрузки';if(r.ok)await scanModelsWeb()}
