	private string GetLlamaBaseDirectory()
	{
		if (!string.IsNullOrWhiteSpace(_settings.LlamaCppBaseDirectory))
			return _settings.LlamaCppBaseDirectory.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
		string defaultDirectory = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "LlamaStudio");
		if (Directory.Exists(defaultDirectory))
			return defaultDirectory;
		if (!string.IsNullOrWhiteSpace(_settings.LlamaCppDirectory))
		{
			string selected = _settings.LlamaCppDirectory.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
			if (File.Exists(Path.Combine(selected, OperatingSystem.IsWindows() ? "llama-server.exe" : "llama-server")))
				return Path.GetDirectoryName(selected) ?? selected;
			return selected;
		}
		return defaultDirectory;
	}

	private static bool TryValidateLlamaBaseDirectory(string requested, out string directory, out string error)
	{
		directory = string.Empty;
		error = string.Empty;
		if (string.IsNullOrWhiteSpace(requested))
		{
			error = "Укажите папку с версиями llama.cpp";
			return false;
		}
		try
		{
			directory = Path.GetFullPath(requested).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
			string root = (Path.GetPathRoot(directory) ?? string.Empty).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
			if (string.Equals(directory, root, StringComparison.OrdinalIgnoreCase))
			{
				error = "Выберите папку с версиями llama.cpp, а не корень диска";
				return false;
			}
			if (!Directory.Exists(directory))
			{
				error = "Указанная папка не существует";
				return false;
			}
			return true;
		}
		catch (Exception ex)
		{
			error = ex.Message;
			return false;
		}
	}

	private async Task RunLlamaInstallAsync(string version, ReleaseAsset asset, CancellationTokenSource source)
	{
		try
		{
			string baseDirectory = GetLlamaBaseDirectory();
			Directory.CreateDirectory(baseDirectory);
			_llamaDownloadProgress = 0;
			_llamaDownloadStatus = $"Загрузка: {version} ({asset.Description})";
			string installPath = await _llamaUpdater.DownloadAndExtractAsync(version, baseDirectory, asset, source.Token);
			await _versionCache.ScanAsync(baseDirectory, CancellationToken.None);
			_llamaDownloadProgress = 100;
			_llamaDownloadStatus = $"Установлено: {Path.GetFileName(installPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))}";
			_log.Information("Web installed llama.cpp: " + version + " -> " + installPath, "LlamaReleases");
		}
		catch (OperationCanceledException)
		{
			_llamaDownloadStatus = "Установка отменена";
			_log.Information("Web llama.cpp installation cancelled", "LlamaReleases");
		}
		catch (Exception ex)
		{
			_llamaDownloadStatus = "Ошибка установки: " + ex.Message;
			_log.Error(ex, "Web llama.cpp installation failed", "LlamaReleases");
		}
		finally
		{
			_llamaDownloading = false;
			_llamaDownloadCts = null;
			Interlocked.Exchange(ref _llamaInstallReservation, 0);
			source.Dispose();
		}
	}

