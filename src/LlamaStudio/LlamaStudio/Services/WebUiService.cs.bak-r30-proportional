let releasePollTimer=null,llamaInstallStartedAt=0,llamaInstallPending=false;
function llamaElapsed(){let seconds=Math.max(0,Math.floor((Date.now()-llamaInstallStartedAt)/1000));return Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0')}
async function pollLlamaInstall(){let data=await json('/api/llama/status'),active=!!data.isDownloading,box=document.getElementById('releaseProgress');if(box)box.style.display=active?'block':'none';let bar=document.getElementById('releaseProgressBar');if(bar)bar.style.width=active?'100%':Math.max(0,Math.min(100,Number(data.progress)||0))+'%';let value=document.getElementById('releaseProgressValue');if(value)value.textContent=active?'Выполняется · '+llamaElapsed():(Number(data.progress)||0).toFixed(0)+'%';let progressStatus=document.getElementById('releaseProgressStatus');if(progressStatus)progressStatus.textContent=(data.status||'Подготовка')+(active?' · прошло '+llamaElapsed():'');if(active){releasePollTimer=setTimeout(pollLlamaInstall,700)}else{llamaInstallPending=false;let finalStatus=data.status||'Установка завершена';await loadInstalledLlama();await checkLlamaReleases();let status=document.getElementById('releaseStatus');if(status)status.textContent=finalStatus}}
async function installLlamaBuild(version,asset,repo=''){if(llamaInstallPending)return;llamaInstallPending=true;llamaInstallStartedAt=Date.now();document.querySelectorAll('#releaseCards button').forEach(b=>b.disabled=true);let status=document.getElementById('releaseStatus');if(status)status.textContent='Запуск установки '+version+'…';try{let response=await fetch('/api/llama/install?version='+encodeURIComponent(version)+'&asset='+encodeURIComponent(asset)+(repo?'&repo='+encodeURIComponent(repo):''));if(!response.ok){llamaInstallPending=false;if(status)status.textContent='Ошибка запуска: '+await response.text();await checkLlamaReleases();return}await pollLlamaInstall()}catch(error){llamaInstallPending=false;if(status)status.textContent='Ошибка запуска: '+error.message;await checkLlamaReleases()}}
async function cancelLlamaInstall(){await fetch('/api/llama/cancel');await pollLlamaInstall()}
async function useLlamaVersion(key,folder){let status=document.getElementById('releaseStatus');if(status)status.textContent='Переключение версии…';let response=await fetch('/api/llama/use?versionKey='+encodeURIComponent(key)+'&folder='+encodeURIComponent(folder)),data=await response.json().catch(()=>({}));if(status)status.textContent=response.ok?'Версия активирована'+(data.restarted?' и сервер перезапущен':''):'Ошибка: '+(data.error||response.status);await loadReleasePage()}
async function removeLlamaVersion(folder){if(!confirm('Удалить установленную версию llama.cpp?'))return;let response=await fetch('/api/llama/remove?folder='+encodeURIComponent(folder)),data=await response.json().catch(()=>({}));let status=document.getElementById('releaseStatus');if(status)status.textContent=response.ok?'Версия удалена':'Ошибка удаления: '+(data.error||response.status);await loadReleasePage()}
async function loadExperimentalReleases(){let repo=document.getElementById('experimentalRepo')?.value||'',status=document.getElementById('experimentalStatus');if(status)status.textContent='Загрузка…';try{experimentalReleases=await json('/api/llama/releases?repo='+encodeURIComponent(repo)+'&latestOnly=false');let select=document.getElementById('experimentalRelease');if(select)select.innerHTML=experimentalReleases.map((release,index)=>'<option value="'+index+'">'+esc(release.tag)+'</option>').join('');renderExperimentalAssets();if(status)status.textContent=experimentalReleases.length?'Последняя: '+experimentalReleases[0].tag:'Релизы не найдены'}catch(error){if(status)status.textContent='Ошибка: '+error.message}}
function renderExperimentalAssets(){let release=experimentalReleases[Number(document.getElementById('experimentalRelease')?.value||0)],select=document.getElementById('experimentalAsset');if(select)select.innerHTML=(release?.assets||[]).map(asset=>'<option value="'+esc(asset.name)+'">'+esc(asset.name)+' — '+esc(asset.sizeDisplay||'')+'</option>').join('')}
