function assetInstalled(tag,asset){let name=String(asset.name||'').toLowerCase();let same=v=>String(v.version||'').toLowerCase()===String(tag||'').toLowerCase();if(name.includes('-local-'))return installedLlamaState.versions.some(v=>same(v)&&String(v.folderName||'').toLowerCase().includes('-local-sm'));if(name.includes('-universal-'))return installedLlamaState.versions.some(v=>same(v)&&String(v.folderName||'').toLowerCase()===String(tag||'').toLowerCase()+'-cuda12x');let type=String(asset.buildType||'').toLowerCase();return installedLlamaState.versions.some(v=>same(v)&&String(v.buildType||'').toLowerCase()===type)}
function renderReleaseCards(releases){let host=document.getElementById('releaseCards'),cards=[];for(const release of releases){for(const asset of (release.assets||[])){let installed=assetInstalled(release.tag,asset);cards.push('<div class="card" style="margin:8px 0"><div class="row"><b>'+esc(release.tag)+'</b><span class="muted">'+releaseDate(release.publishedAt)+'</span>'+releaseBadge(asset)+'<span class="muted">'+esc(asset.sizeDisplay||((Number(asset.size||0)/1048576).toFixed(1)+' MB'))+'</span><button class="green" '+(installed||llamaInstallPending?'disabled':'')+' onclick="installLlamaBuild(\''+jsq(release.tag)+'\',\''+jsq(asset.name)+'\')">'+(installed?'Установлено':'Установить')+'</button></div><div class="muted" style="margin-top:8px;font-size:12px">'+esc(asset.name)+'</div></div>')}}host.innerHTML=cards.join('')||'<div class="muted">Релизы не найдены</div>'}
async function loadLlamaDirectory(){let data=await json('/api/llama/installed');installedLlamaState=data;let input=document.getElementById('llamaBaseDirectory');if(input)input.value=data.baseDirectory||'';return data}
async function loadInstalledLlama(){let data=await loadLlamaDirectory(),title=document.getElementById('installedLlamaTitle'),host=document.getElementById('installedLlamaList');if(title)title.textContent=data.active?'Активна: '+data.active:'Активная версия не выбрана';let html=(data.versions||[]).map(v=>'<div class="card" style="margin:8px 0"><div class="row"><b>'+esc(v.version||v.folderName)+'</b>'+releaseBadge({description:v.buildType||'CPU only',buildType:v.buildType})+(v.isActive?'<span class="tag green">Активна</span>':'')+'</div><div class="muted" style="margin:7px 0">'+esc(v.folderName||'')+'</div><div class="actions">'+(v.isActive?'<button class="secondary" disabled>Активная</button>':'<button onclick="useLlamaVersion(\''+jsq(v.versionKey||'')+'\',\''+jsq(v.folderName||'')+'\')">Использовать</button><button class="stop" onclick="removeLlamaVersion(\''+jsq(v.folderName||'')+'\')">Удалить</button>')+'</div></div>').join('');if(host)host.innerHTML=html||'<div class="muted">Установленные версии не найдены</div>';return data}
async function checkLlamaReleases(){let status=document.getElementById('releaseStatus'),button=document.getElementById('releaseCheckButton');if(status)status.textContent='Проверка обновлений…';if(button)button.disabled=true;try{await loadInstalledLlama();let only=document.getElementById('releaseLatestOnly')?.checked?'true':'false';let releases=await json('/api/llama/releases?latestOnly='+only);renderReleaseCards(releases);if(status)status.textContent=releases.length?'Последняя: '+releases[0].tag:'Релизы не найдены'}catch(error){if(status)status.textContent='Ошибка: '+error.message}finally{if(button)button.disabled=false}}
