	public static async Task<List<CliArgDefinition>?> ParseHelpAsync(string executablePath)
	{
		if (string.IsNullOrWhiteSpace(executablePath) || !File.Exists(executablePath))
		{
			return null;
		}
		try
		{
			ProcessStartInfo startInfo = new ProcessStartInfo
			{
				FileName = executablePath,
				Arguments = "--help",
				UseShellExecute = false,
				RedirectStandardOutput = true,
				RedirectStandardError = true,
				CreateNoWindow = true,
				StandardOutputEncoding = Encoding.UTF8,
				StandardErrorEncoding = Encoding.UTF8
			};
			using Process process = new Process
			{
				StartInfo = startInfo
			};
			process.Start();
			Task<string> outputTask = process.StandardOutput.ReadToEndAsync();
			Task<string> errorTask = process.StandardError.ReadToEndAsync();
			using CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(10.0));
			try
			{
				await process.WaitForExitAsync(cts.Token);
			}
			catch (OperationCanceledException)
			{
				try
				{
					process.Kill(entireProcessTree: true);
				}
				catch
				{
				}
				return null;
			}
			string text = await outputTask + "\n" + await errorTask;
			if (string.IsNullOrWhiteSpace(text))
			{
				return null;
			}
			return ParseArgumentDescriptions(text);
		}
		catch
		{
			return null;
		}
	}

	public static List<CliArgDefinition> ParseArgumentDescriptions(string helpText)
	{
		List<CliArgDefinition> list = new List<CliArgDefinition>();
		if (string.IsNullOrWhiteSpace(helpText))
		{
			return list;
		}
		string[] array = helpText.Split('\n');
		string category = "other";
		CliArgDefinition cliArgDefinition = null;
		List<string> list2 = new List<string>();
		foreach (string text in array)
		{
			string text2 = text.TrimStart();
			if (text2.StartsWith("-----") && text2.Contains("params"))
			{
				category = ParseCategory(text2);
			}
			else if (text2.StartsWith("-"))
			{
				if (cliArgDefinition != null)
				{
					Finalize(cliArgDefinition, list2.ToList());
					list.Add(cliArgDefinition);
				}
				int num = FindBoundary(text);
				string input;
				string text3;
				if (num >= 0 && num < text.Length)
				{
					input = text.Substring(0, num).TrimEnd();
					text3 = text.Substring(num).TrimStart();
				}
				else
				{
					input = text.TrimEnd();
					text3 = "";
				}
				MatchCollection matchCollection = FlagRegex.Matches(input);
				List<string> list3 = new List<string>();
				foreach (Match item in matchCollection)
				{
					if (!string.IsNullOrEmpty(item.Value))
					{
						list3.Add(item.Value);
					}
				}
				string text4 = "";
				using (IEnumerator<string> enumerator2 = list3.Where((string f) => f.StartsWith("--")).GetEnumerator())
				{
					if (enumerator2.MoveNext())
					{
						text4 = enumerator2.Current;
					}
				}
				if (string.IsNullOrEmpty(text4) && list3.Count > 0)
				{
					text4 = list3[0];
				}
				cliArgDefinition = new CliArgDefinition
				{
					PrimaryFlag = text4,
					Aliases = list3,
					Category = category
				};
				list2.Clear();
				if (!string.IsNullOrWhiteSpace(text3))
				{
					list2.Add(text3);
				}
			}
			else if (cliArgDefinition != null && !string.IsNullOrWhiteSpace(text) && text.StartsWith(" "))
			{
				list2.Add(text2);
			}
		}
		if (cliArgDefinition != null)
		{
			Finalize(cliArgDefinition, list2.ToList());
			list.Add(cliArgDefinition);
		}
		return list;
	}

	private static void Finalize(CliArgDefinition arg, List<string> lines)
	{
		string input = string.Join(" ", lines).Trim();
		Match match = Regex.Match(input, "\\(default:\\s*([^)]+)\\)");
		if (match.Success)
		{
			arg.DefaultValue = CleanDefault(match.Groups[1].Value.Trim());
		}
		input = Regex.Replace(input, "\\s*\\(default:\\s*[^)]+\\)", "");
		input = Regex.Replace(input, "\\s*\\(env:\\s*[^)]+\\)", "");
		arg.DescriptionEn = input.Trim();
		string text = NormalizeArgKey(arg.PrimaryFlag);
		if (!string.IsNullOrEmpty(text) && RuDescriptions.TryGetValue(text, out string value))
		{
			string text2 = ExtractFlagValuePrefix(input);
			arg.DescriptionRu = (string.IsNullOrEmpty(text2) ? value : (text2 + " " + value).Trim());
		}
		Match match2 = Regex.Match(arg.PrimaryFlag + " " + string.Join(" ", lines), "\\[([^\\]]+)\\]");
		if (match2.Success)
		{
			arg.AllowedValues = (from v in match2.Groups[1].Value.Split('|')
				select v.Trim() into v
				where !string.IsNullOrEmpty(v)
				select v).ToList();
		}
		Match match3 = Regex.Match(arg.PrimaryFlag + " " + string.Join(" ", lines), "<([^>]+)>");
		if (arg.AllowedValues.Count == 0 && match3.Success)
		{
			arg.AllowedValues = (from v in match3.Groups[1].Value.Split('|')
				select v.Trim() into v
				where !string.IsNullOrEmpty(v)
				select v).ToList();
		}
		int num = input.IndexOf("allowed values:", StringComparison.OrdinalIgnoreCase);
		if (num >= 0)
		{
			string text3 = input.Substring(num + "allowed values:".Length).TrimStart();
			arg.AllowedValues = (from v in text3.Split(',')
				select v.Trim() into v
				where !string.IsNullOrEmpty(v)
				select v).ToList();
		}
		arg.InferredArgType = InferArgType(arg);
		static string ExtractFlagValuePrefix(string desc)
		{
			if (string.IsNullOrEmpty(desc))
			{
				return "";
			}
			Match match4 = Regex.Match(desc, "^--[\\w-]+\\s+\\S+");
			if (match4.Success)
			{
				return match4.Value;
			}
			match4 = Regex.Match(desc, "^-([a-zA-Z])\\b\\s+\\S+");
			if (match4.Success)
			{
				return match4.Value;
			}
			return "";
		}
	}

	private static ArgType? InferArgType(CliArgDefinition arg)
	{
		foreach (string item in new string[1] { arg.PrimaryFlag }.Concat(arg.Aliases))
		{
			if (!string.IsNullOrEmpty(item))
			{
				ArgType? argType = CommandLineParser.GetArgType(item.TrimStart('-'));
				if (argType.HasValue)
				{
					return argType.Value;
				}
			}
		}
		if (arg.AllowedValues.Count == 2 && arg.AllowedValues.Contains<string>("on", StringComparer.OrdinalIgnoreCase) && arg.AllowedValues.Contains<string>("off", StringComparer.OrdinalIgnoreCase))
		{
			return ArgType.BoolOnOff;
		}
		string text = arg.DefaultValue.Trim();
		if (!string.IsNullOrEmpty(text) && !IsDefaultLikeFlag(text))
		{
			if (int.TryParse(text, out var _))
			{
				return ArgType.Int;
			}
			if (float.TryParse(text, out var _))
			{
				return ArgType.Float;
			}
		}
		return null;
	}

	private static bool IsDefaultLikeFlag(string value)
	{
		switch (value.ToLowerInvariant())
		{
		case "enabled":
		case "disabled":
		case "on":
		case "off":
		case "true":
		case "false":
			return true;
		default:
			return false;
		}
	}

	private static string CleanDefault(string value)
	{
		bool flag;
		switch (value.ToLowerInvariant().Trim())
		{
		case "enabled":
		case "disabled":
		case "on":
		case "off":
		case "true":
		case "false":
			flag = true;
			break;
		default:
			flag = false;
			break;
		}
		if (flag)
		{
			return "";
		}
		return value;
	}

	private static int FindBoundary(string line)
	{
		for (int i = 0; i < Math.Min(line.Length - 1, 80); i++)
		{
			if ((line[i] == ' ' && line[i + 1] == ' ') || line[i] == '\t')
			{
				int j;
				for (j = i; j < line.Length && (line[j] == ' ' || line[j] == '\t'); j++)
				{
				}
				return j;
			}
		}
		return -1;
	}

	private static string ParseCategory(string section)
	{
		string text = section.ToLowerInvariant();
		if (text.Contains("common"))
		{
			return "common";
		}
		if (text.Contains("sampling"))
		{
			return "sampling";
		}
		if (text.Contains("speculative"))
		{
			return "speculative";
		}
		if (text.Contains("server") || text.Contains("example-specific"))
		{
			return "server";
		}
		return "other";
	}

	public static List<CliArgDefinition> FilterMissingFlags(List<CliArgDefinition> all, string? customArgs = null)
	{
		HashSet<string> customFlags = ParseCustomFlags(customArgs);
		return all.Where((CliArgDefinition a) => !a.Aliases.Any((string f) => UiExposedFlags.Contains(f) || customFlags.Contains(f))).ToList();
	}

	private static HashSet<string> ParseCustomFlags(string? customArgs)
	{
		HashSet<string> hashSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
		if (string.IsNullOrWhiteSpace(customArgs))
		{
			return hashSet;
		}
		string[] array = customArgs.Split(new char[1] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
		for (int i = 0; i < array.Length; i++)
		{
			string text = array[i].Trim();
			if (text.StartsWith("-"))
			{
				hashSet.Add(text);
			}
		}
		return hashSet;
	}

	private static string NormalizeArgKey(string flag)
	{
		if (string.IsNullOrEmpty(flag))
		{
			return "";
		}
		return flag.TrimStart('-').Replace("-", "_");
	}
