using System;
using System.ComponentModel;
using System.Linq;
using System.Collections.Specialized;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Layout;
using Avalonia.Media;
using Avalonia.Controls.Primitives;
using Avalonia.Controls.Shapes;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.VisualTree;
using Avalonia.Threading;
using LlamaStudio.Core.Models;
using LlamaStudio.ViewModels;

namespace LlamaStudio.Views.Controls;

public sealed class MultiGpuSettingsControl : UserControl
{
	private readonly StackPanel _content = new StackPanel { Spacing = 8 };
	private readonly MultiGpuServerMonitoringControl _serverMonitoringControl = new MultiGpuServerMonitoringControl();
	private ServerViewModel? _viewModel;
	private bool _sliderInteractionActive;
	private bool _rebuildQueued;
	private bool _queuedRebuildRequiresFull;
	private string _gpuStructureSignature = string.Empty;

	public MultiGpuSettingsControl()
	{
		Content = _content;
		PropertyChanged += (_, args) =>
		{
			if (args.Property == DataContextProperty)
			{
				SetViewModel(DataContext as ServerViewModel);
			}
		};
	}

	private void SetViewModel(ServerViewModel? viewModel)
	{
		if (_viewModel != null)
		{
			_viewModel.PropertyChanged -= OnViewModelPropertyChanged;
			((INotifyCollectionChanged)_viewModel.GpuInfos).CollectionChanged -= OnGpuInfosCollectionChanged;
		}
		_viewModel = viewModel;
		if (_viewModel != null)
		{
			_viewModel.PropertyChanged += OnViewModelPropertyChanged;
			((INotifyCollectionChanged)_viewModel.GpuInfos).CollectionChanged += OnGpuInfosCollectionChanged;
		}
		Rebuild();
	}

	public void AttachViewModel(ServerViewModel viewModel)
	{
		SetViewModel(viewModel);
	}

	private void OnGpuInfosCollectionChanged(object? sender, NotifyCollectionChangedEventArgs e)
	{
		if (_sliderInteractionActive)
		{
			return;
		}
		if (!GpuStructureChanged())
		{
			return;
		}
		RequestRebuild(onlyIfStructureChanged: true);
	}

	private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
	{
		if (e.PropertyName == "GpuInfos" && !GpuStructureChanged())
		{
			return;
		}
		if (e.PropertyName is "GpuInfos" or "HasMultipleGpus" or "SelectedGpuDeviceText" or "UsedGpusLabel" or "MainGpuDisabledTensorSplitLabel" or "ModelDistributionLabel" or "AutomaticDistributionLabel" or "GpuMonitoringLabel" || (e.PropertyName == "TensorSplit" && !_sliderInteractionActive))
		{
			RequestRebuild(onlyIfStructureChanged: e.PropertyName == "GpuInfos");
		}
	}

	private void RequestRebuild(bool onlyIfStructureChanged = false)
	{
		_queuedRebuildRequiresFull |= !onlyIfStructureChanged;
		if (_rebuildQueued)
		{
			return;
		}
		_rebuildQueued = true;
		Dispatcher.UIThread.Post(() =>
		{
			_rebuildQueued = false;
			bool requiresFullRebuild = _queuedRebuildRequiresFull;
			_queuedRebuildRequiresFull = false;
			if (requiresFullRebuild || GpuStructureChanged())
			{
				Rebuild();
			}
		});
	}

	private void Rebuild()
	{
		_gpuStructureSignature = GetGpuStructureSignature();
		_content.Children.Clear();
		if (_viewModel == null || _viewModel.GpuInfos.Count == 0)
		{
			IsVisible = false;
			return;
		}
		if (_viewModel.GpuInfos.Count <= 1)
		{
			IsVisible = true;
			_serverMonitoringControl.DataContext = _viewModel;
			_serverMonitoringControl.Margin = new Thickness(0, 8, 0, 0);
			_content.Children.Add(_serverMonitoringControl);
			return;
		}
		IsVisible = true;
		_content.Children.Add(new TextBlock { Text = _viewModel.UsedGpusLabel, FontSize = 13, FontWeight = FontWeight.DemiBold });
		foreach (GpuInfo gpu in _viewModel.GpuInfos)
		{
			CheckBox checkBox = new CheckBox { Content = gpu.DisplayName, IsChecked = gpu.IsSelected };
			int index = gpu.Index;
			checkBox.IsCheckedChanged += (_, _) => _viewModel.SetGpuSelected(index, checkBox.IsChecked == true);
			_content.Children.Add(checkBox);
		}

		bool tensorSplitActive = _viewModel.GpuInfos.Count(item => item.IsSelected) > 1 && !string.IsNullOrWhiteSpace(_viewModel.TensorSplit);
		_content.Children.Add(new TextBlock { Text = tensorSplitActive ? _viewModel.MainGpuDisabledTensorSplitLabel : _viewModel.MainGpuShortLabel, Foreground = new SolidColorBrush(Color.Parse("#A8AFBF")), Margin = new Thickness(0, 4, 0, 0) });
		foreach (GpuInfo gpu in _viewModel.GpuInfos.Where(item => item.IsSelected && !item.IsRemote))
		{
			RadioButton radio = new RadioButton { Content = gpu.DisplayName, GroupName = "MainGpu", IsChecked = gpu.Index == _viewModel.MainGpu, IsEnabled = !tensorSplitActive };
			ToolTip.SetTip(radio, tensorSplitActive ? _viewModel.MainGpuSplitTip : _viewModel.MainGpuTip);
			int index = gpu.Index;
			radio.IsCheckedChanged += (_, _) => { if (radio.IsChecked == true) _viewModel.SetMainGpuFromSelection(index); };
			_content.Children.Add(radio);
		}

		var selected = _viewModel.GpuInfos.Where(item => item.IsSelected).ToArray();
		if (selected.Length == 2)
		{
			_content.Children.Add(new TextBlock { Text = _viewModel.ModelDistributionLabel });
			int first = ParseSplit(_viewModel.TensorSplit, 0, 50);
			TextBlock value = new TextBlock { Text = $"{selected[0].Name}: {first}%   {selected[1].Name}: {100 - first}%" };
			Control slider = CreateSplitSlider(first, value, selected[0].Name, selected[1].Name);
			_content.Children.Add(slider);
			_content.Children.Add(value);
		}
		Button auto = new Button { Content = _viewModel.AutomaticDistributionLabel, HorizontalAlignment = HorizontalAlignment.Left };
		auto.Click += (_, _) => _viewModel.ApplyAutomaticTensorSplit();
		_content.Children.Add(auto);
		_serverMonitoringControl.DataContext = _viewModel;
		_serverMonitoringControl.Margin = new Thickness(0, 8, 0, 0);
		_content.Children.Add(_serverMonitoringControl);
	}

	private bool GpuStructureChanged() => !string.Equals(_gpuStructureSignature, GetGpuStructureSignature(), StringComparison.Ordinal);

	private string GetGpuStructureSignature()
	{
		if (_viewModel == null)
		{
			return string.Empty;
		}
		return string.Join("|", _viewModel.GpuInfos.Select(gpu => $"{gpu.Index}:{gpu.RemoteDeviceId}:{gpu.Name}:{gpu.IsRemote}"));
	}

	private Control CreateSplitSlider(int initialValue, TextBlock value, string firstName, string secondName)
	{
		int currentValue = Math.Max(1, Math.Min(99, initialValue));
		const double padding = 10;
		Canvas ruler = new Canvas
		{
			Height = 44,
			MinHeight = 44,
			Background = Brushes.Transparent,
			HorizontalAlignment = HorizontalAlignment.Stretch
		};
		Border track = new Border { Height = 8, Background = new SolidColorBrush(Color.Parse("#667085")), CornerRadius = new CornerRadius(4) };
		Border fill = new Border { Height = 8, Background = new SolidColorBrush(Color.Parse("#4D8DCC")), CornerRadius = new CornerRadius(4) };
		Border marker = new Border { Width = 3, Height = 24, Background = new SolidColorBrush(Color.Parse("#A8D1F2")), CornerRadius = new CornerRadius(2) };
		ruler.Children.Add(track);
		ruler.Children.Add(fill);
		ruler.Children.Add(marker);
		for (int percent = 0; percent <= 100; percent += 10)
		{
			TextBlock tick = new TextBlock { Text = $"{percent}%", FontSize = 10, Foreground = new SolidColorBrush(Color.Parse("#A8AFBF")) };
			ruler.Children.Add(tick);
			int tickPercent = percent;
			ruler.SizeChanged += (_, _) =>
			{
				double width = Math.Max(1, ruler.Bounds.Width - padding * 2);
				Canvas.SetLeft(tick, padding + width * tickPercent / 100.0 - (tick.Bounds.Width / 2));
				Canvas.SetTop(tick, 28);
			};
		}

		void UpdateVisual()
		{
			double usableWidth = Math.Max(1, ruler.Bounds.Width - padding * 2);
			double markerCenter = padding + (currentValue - 1) / 98.0 * usableWidth;
			Canvas.SetLeft(track, padding); Canvas.SetTop(track, 10); track.Width = usableWidth;
			Canvas.SetLeft(fill, padding); Canvas.SetTop(fill, 10); fill.Width = Math.Max(0, markerCenter - padding);
			Canvas.SetLeft(marker, markerCenter - marker.Width / 2); Canvas.SetTop(marker, 2);
			value.Text = $"{firstName}: {currentValue}%   {secondName}: {100 - currentValue}%";
		}

		void SetValue(int nextValue)
		{
			currentValue = Math.Max(1, Math.Min(99, nextValue));
			UpdateVisual();
			_viewModel?.SetTensorSplitFromSlider(currentValue);
		}

		ruler.PointerPressed += (_, args) =>
		{
			if (args.GetCurrentPoint(ruler).Properties.IsLeftButtonPressed)
			{
				double usableWidth = Math.Max(1, ruler.Bounds.Width - padding * 2);
				double ratio = Math.Max(0, Math.Min(1, (args.GetPosition(ruler).X - padding) / usableWidth));
				SetValue((int)Math.Round(1 + ratio * 98));
				args.Handled = true;
			}
		};
		StackPanel controls = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 6, HorizontalAlignment = HorizontalAlignment.Center };
		foreach ((string label, int delta) in new[] { ("−5%", -5), ("−1%", -1), ("+1%", 1), ("+5%", 5) })
		{
			Button button = new Button { Content = label, Padding = new Thickness(12, 4), MinWidth = 52 };
			button.Click += (_, _) => SetValue(currentValue + delta);
			controls.Children.Add(button);
		}
		StackPanel result = new StackPanel { Spacing = 4 };
		result.Children.Add(ruler);
		result.Children.Add(controls);
		result.SizeChanged += (_, _) => UpdateVisual();
		Dispatcher.UIThread.Post(UpdateVisual);
		return result;
	}

	private static int ParseSplit(string value, int index, int fallback)
	{
		string[] parts = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
		return index < parts.Length && int.TryParse(parts[index], out int result) ? Math.Max(1, Math.Min(99, result)) : fallback;
	}
}
